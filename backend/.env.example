# Club & Event Concierge — backend environment template.
# Copy to `.env` and fill in real values. Never commit the populated .env.

# --- Database (asyncpg / Supabase Postgres + pgvector) --------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_COMMAND_TIMEOUT=30.0

# --- AI providers (all free tiers) ---------------------------------------
GROQ_API_KEY=your_groq_key_here             # chat answers + query understanding
GEMINI_API_KEY=your_gemini_key_here         # reads Instagram flyer images (vision)
GEMINI_VISION_MODEL=gemini-flash-latest

# --- Instagram scraping ---------------------------------------------------
APIFY_API_TOKEN=your_apify_token_here

# --- Optional: Google sign-in --------------------------------------------
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# --- Tuning (safe defaults) ----------------------------------------------
LOG_LEVEL=INFO
EMBEDDING_DIM=1536
HNSW_EF_SEARCH=40
